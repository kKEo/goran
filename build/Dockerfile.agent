# syntax=docker/dockerfile:1
FROM golang:1.23-alpine AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /out/goran-agent ./agent

FROM alpine:3.20
# Tools the task kinds need: git for sources, bash/sh for shell tasks,
# terraform and ansible for their runners. Set INSTALL_ANSIBLE=0 for a slim image.
ARG TERRAFORM_VERSION=1.9.8
ARG INSTALL_ANSIBLE=1
RUN apk add --no-cache ca-certificates git bash openssh-client curl unzip \
 && if [ "$INSTALL_ANSIBLE" = "1" ]; then apk add --no-cache ansible; fi \
 && ARCH="$(apk --print-arch)" && case "$ARCH" in x86_64) TF_ARCH=amd64;; aarch64) TF_ARCH=arm64;; *) echo "unsupported arch $ARCH" && exit 1;; esac \
 && curl -fsSL "https://releases.hashicorp.com/terraform/${TERRAFORM_VERSION}/terraform_${TERRAFORM_VERSION}_linux_${TF_ARCH}.zip" -o /tmp/tf.zip \
 && unzip -q /tmp/tf.zip -d /usr/local/bin && rm /tmp/tf.zip \
 && adduser -D -u 10001 goran
COPY --from=build /out/goran-agent /usr/local/bin/goran-agent
USER goran
WORKDIR /home/goran
ENV GORAN_AGENT_CONFIG=/home/goran/agent.json GORAN_WORKDIR=/home/goran/work
ENTRYPOINT ["goran-agent"]
CMD ["run"]
