# syntax=docker/dockerfile:1
FROM golang:1.23-alpine AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /out/goran-server ./webapp

FROM alpine:3.20
RUN apk add --no-cache ca-certificates tzdata && adduser -D -u 10001 goran
COPY --from=build /out/goran-server /usr/local/bin/goran-server
USER goran
WORKDIR /data
VOLUME ["/data"]
ENV GORAN_ADDR=:8080 GORAN_DB=/data/goran.sqlite
EXPOSE 8080
ENTRYPOINT ["goran-server"]
CMD ["serve"]
